@page "/"
@using Microsoft.Extensions.Options
@using ShopFloorAssistant.Core.AI
@inject IOptions<AiOptions> Options

<PageTitle>ShopFloor Assistant</PageTitle>

<h1>ShopFloor Assistant</h1>

<p>Ask your work instructions: answers from SOPs and machine manuals, always with the source page.</p>

<p><strong>Status:</strong> work in progress. Document ingestion and chat are the next milestones.</p>

<dl>
    <dt>Chat model</dt>
    <dd>@Ai.Chat.Model (@Ai.Chat.Provider)</dd>
    <dt>Embedding model</dt>
    <dd>@Ai.Embeddings.Model (@Ai.Embeddings.Provider)</dd>
</dl>

@code {
    private AiOptions Ai => Options.Value;
}
